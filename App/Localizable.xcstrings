    "Changes couldn’t be saved: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan belum tersimpan: %@"
          }
        }
      }
    },
    "Choose a piece from the tray, then tap the cell where its top-left corner should go. Pieces cannot be rotated. Full rows and columns clear together. You get one point per cell placed and 10 per line cleared. A new tray appears after you use all three pieces. The game ends when none of the remaining pieces fit.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih keping dari baki, lalu tap petak untuk pojok kiri atas keping. Keping tidak dapat diputar. Baris dan kolom penuh dibersihkan bersamaan. Skor: satu poin per sel keping ditambah 10 per garis. Baki baru muncul sesudah ketiga keping terpakai. Sesi berakhir ketika tidak ada keping tersisa yang dapat diletakkan."
          }
        }
      }
    },
    "Choose a piece, then tap where its top-left corner should go.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih keping, lalu tap pojok kiri atas tempatnya."
          }
        }
      }
    },
    "Column %lld empty, kings only": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom %lld kosong, hanya King"
          }
        }
      }
    },
